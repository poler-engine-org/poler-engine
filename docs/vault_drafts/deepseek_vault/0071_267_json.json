{
"name": "poler-toolkit",
"version": "3.2.0",
"category": "text-analysis",
"priority": 80,
"cost": {
"cpu": "medium",
"ram": "2GB",
"time": "2-10s per doc",
"network": false
},
"triggers": {
"file_extensions": [".pdf", ".txt", ".md", ".html", ".zip"],
    "content_contains": ["анализ", "текст", "тема", "cluster"],
"mime_types": ["application/pdf", "text/plain"]
},
"inputs": {
"schema": {
"type": "object",
"properties": {
"input": {"type": "string", "description": "file path, URL, or stdin"},
"llm": {"type": "boolean", "default": false},
"json": {"type": "boolean", "default": false}
}
}
},
"outputs": {
"schema": {
"type": "object",
"properties": {
"text": {"type": "string"},
"meta": {"type": "object"},
"theme": {"type": "object"},
"keywords": {"type": "array", "items": {"type": "string"}},
"clusters": {"type": "array"},
"confidence": {"type": "number", "minimum": 0, "maximum": 1}
},
"required": ["text", "meta", "theme", "confidence"]
}
},
"requires": {
"python": ">=3.10",
"tesseract": true,
"poppler": true
},
"dependencies": ["pdf-ocr"]
}

